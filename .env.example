# Example overrides; omit a key to use its runtime default.
# Authoritative settings and precedence: docs/test-config.md

## Core snapshot/WAL
# VECTORDB_PERSIST_PATH=data/snapshot.bin
# VECTORDB_WAL_PATH=
# VECTORDB_WAL_DIR=
# VECTORDB_WAL_AUTO_REPLAY=1
# VECTORDB_WAL_FSYNC=1
# VECTORDB_WAL_FSYNC_EVERY=100
# VECTORDB_WAL_FSYNC_MS=100
# VECTORDB_MAX_RSS_MB=0
# VECTORDB_OOM_SNAPSHOT_PATH=

## HNSW/search tuning
# VECTORDB_M=16
# VECTORDB_M0=16
# VECTORDB_EF_SEARCH_LIST=64,128,256
# VECTORDB_EF_SEARCH=64
# VECTORDB_EF_CONSTRUCT=200
# VECTORDB_MAX_LEVEL=16
# VECTORDB_EARLY_EXIT_PATIENCE=3
# VECTORDB_DISABLE_EARLY_EXIT=0
# VECTORDB_SEARCH_EXPANSION_MULT=4
# VECTORDB_SEARCH_EXPANSION_CAP=0
# VECTORDB_FILTER_EXPANSION_CAP=0
# VECTORDB_FILTER_PASSING_BUDGET=
# VECTORDB_FILTER_FAILING_BUDGET=
# VECTORDB_ENABLE_FILTER_SEEDS=0
# VECTORDB_EXACT_FALLBACK_ENABLED=1
# VECTORDB_EXACT_FALLBACK_THRESHOLD=
# VECTORDB_FILTER_ENTRY_CANDIDATES=
# VECTORDB_DIVERSITY_ALPHA=1

## Filter/payload behavior
# VECTORDB_FILTER_KEYS=
# VECTORDB_FILTER_MAX_KEYS=
# VECTORDB_FILTER_EDGES=
# VECTORDB_PURGE_DELETIONS=0

## Logging/trace
# VECTORDB_TEST_LOG=info
# VECTORDB_PROGRESS_EVERY=100
# VECTORDB_QUERY_LOG=logs/query_log.jsonl
# VECTORDB_QUERY_LOG_EVERY=1
# VECTORDB_SEARCH_TRACE_LOG=logs/search_trace.jsonl
# VECTORDB_INSERT_TRACE_LOG=logs/insert_trace.jsonl
# VECTORDB_TRACE_EVERY=100
# VECTORDB_FILTER_SEARCH_LOG=logs/filter_search.jsonl
# VECTORDB_LOG_UNFILTERED_SEARCH=0
# VECTORDB_LOG_UNFILTERED_EVERY=100
# VECTORDB_LOG_FILTER_SEED_EVERY=100
# VECTORDB_LOG_FILTER_SEED=0
# VECTORDB_LOG_FILTER_EDGES_AGG=0
# VECTORDB_LOG_INSERT_TIMING=0

## Dataset-specific (NYTimes)
# VECTORDB_NYT_DATA_DIR=data/nytimes-256-angular
# VECTORDB_NYT_PERSIST_PATH=data/nytimes-256-angular/index_m16_m0_32_efc100.bin
# VECTORDB_NYT_USE_SNAPSHOT=1
# VECTORDB_NYT_ALLOW_BUILD=0
# VECTORDB_NYT_SAVE_SNAPSHOT=0
# VECTORDB_NYT_M=16
# VECTORDB_NYT_M0=32
# VECTORDB_NYT_EF_SEARCH_LIST=64,128,256
# VECTORDB_NYT_EF_CONSTRUCT=100

## Dataset-specific (H&M)
# VECTORDB_HNM_DATA_DIR=data/hnm
# VECTORDB_HNM_PERSIST_PATH=data/hnm/index_filtered.bin
# VECTORDB_HNM_USE_SNAPSHOT=1
# VECTORDB_HNM_ALLOW_BUILD=0
# VECTORDB_HNM_SAVE_SNAPSHOT=0
# VECTORDB_HNM_M=16
# VECTORDB_HNM_M0=16
# VECTORDB_HNM_EF_SEARCH_LIST=64,128,256
# VECTORDB_HNM_EF_CONSTRUCT=200
# VECTORDB_HNM_TOPK=
# VECTORDB_HNM_QUERIES=200
# VECTORDB_HNM_BASE_LIMIT=

## Recall/bench harness
# VECTORDB_USE_SNAPSHOT=1
# VECTORDB_ALLOW_BUILD=0
# VECTORDB_SAVE_SNAPSHOT=0
# VECTORDB_TOPK=20
# VECTORDB_QUERIES=20
# VECTORDB_BASE_LIMIT=
# VECTORDB_SIZE=20000
# VECTORDB_DIM=1536
# VECTORDB_RECALL_SIZE=20000
# VECTORDB_RECALL_DIM=1536
# VECTORDB_RECALL_EF_SEARCH=64,128,256
# VECTORDB_RECALL_TOPK=20
# VECTORDB_RECALL_QUERIES=20
# VECTORDB_RECALL_SEED=
# VECTORDB_RECALL_NOISE=
# VECTORDB_RECALL_RANDOM=0
# VECTORDB_RECALL_METRIC=euclidean
# VECTORDB_RECALL_EF_CONSTRUCT=200
# VECTORDB_BENCH_SIZE=100000
# VECTORDB_BENCH_DIM=512

## Kernel microbench
# VECTORDB_KERNEL_METRIC=cosine
# VECTORDB_KERNEL_DIM=1024
# VECTORDB_KERNEL_VECS=100000
# VECTORDB_KERNEL_ITERS=100

# AVX-512 BF16 scoring for FDE dot products and MaxSim (Sapphire Rapids, Zen 4). Off by default.
# BF16 rounds each operand to bfloat16, so a score differs from the f32 value by up to about
# 2^-7 of the vectors' magnitudes, and the exact and ANN backends (BF16 vs f32) can disagree
# about a document's score. Set to 1 to trade that for throughput on CPUs that have it.
# VECTORDB_BF16=0
